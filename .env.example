# Copy to .env and `export $(cat .env | xargs)`, or set these in your shell.
PARAG_DATA_DIR=./data
PARAG_PASSPHRASE=change-me            # unlocks the encrypted vault; never commit the real one
PARAG_LLM=ollama                      # ollama | extractive (no model, offline)
PARAG_LLM_MODEL=qwen2.5:3b            # any model you have pulled in Ollama, e.g. phi3
PARAG_S1_ENGINE=rules
PARAG_TAU_FAST=0.75                   # System 1 answers alone only above this confidence
PARAG_TRACING=off                     # off | phoenix

# Copy to .env and `export $(cat .env | xargs)`, or set these in your shell.
SMRITI_DATA_DIR=~/.smriti/data
SMRITI_PASSPHRASE=change-me            # unlocks the encrypted vault; never commit the real one
SMRITI_LLM=ollama                      # ollama | extractive (no model, offline)
SMRITI_LLM_MODEL=qwen2.5:3b            # any model you have pulled in Ollama, e.g. phi3
SMRITI_S1_ENGINE=rules
SMRITI_TAU_FAST=0.75                   # System 1 answers alone only above this confidence
SMRITI_TRACING=off                     # off | phoenix
